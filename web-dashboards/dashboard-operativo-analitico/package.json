{
    "name": "dashboard-operativo-analitico",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "yarn@4.18.0",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "mock:data": "node scripts/generate-mock-data.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -b",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "prepare": "husky"
    },
    "dependencies": {
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "animejs": "^4.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "lucide-react": "^1.31.0",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.8",
        "react-is": "^19.2.8",
        "react-router-dom": "^7.18.2",
        "recharts": "3.8.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "xlsx": "^0.18.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/react-is": "^19",
        "@vitejs/plugin-react": "^6.0.4",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.0",
        "prettier": "^3.6.2",
        "shadcn": "^4.18.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.50.0",
        "vite": "^8.2.0",
        "vitest": "^4.0.16"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,scss}": [
            "prettier --write"
        ],
        "*.{json,md,yaml,yml,html}": [
            "prettier --write"
        ]
    }
}
