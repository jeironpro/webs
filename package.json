{
  "name": "webs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Catalogo entrypoint de las webs del monorepo",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "data:build": "node scripts/build-data.mjs",
    "data:screenshots": "node scripts/captura-screenshots.mjs",
    "hubs:build": "node scripts/compila-hubs.mjs",
    "links:check": "node scripts/check-links.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "capturas:check": "node scripts/check-capturas.mjs",
    "audit:rules": "node scripts/audit-web-rules.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "globals": "^15",
    "jsdom": "^29",
    "prettier": "^3",
    "vitest": "^3",
    "yaml": "^2"
  }
}
