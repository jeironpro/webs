{
    "name": "exerciness",
    "version": "0.1.0",
    "private": true,
    "description": "Catálogo de ejercicios de gimnasio con búsqueda, filtros, favoritos y comparador. Frontend vanilla JS.",
    "packageManager": "yarn@4.9.2",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "data:sync": "node scripts/sync-data.mjs",
        "media:optimize": "python3 scripts/optimize-media.py",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --passWithNoTests",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "eslint": "^9.39.0",
        "globals": "^16.5.0",
        "prettier": "^3.6.2",
        "vite": "^7.1.13",
        "vitest": "^3.2.4"
    }
}
